# Upbit API credentials.
# Never commit real keys. Create a local .env from this file.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# AI analysis. The client uses an OpenAI-compatible chat completions endpoint.
CURSOR_API_KEY=
AI_BASE_URL=https://api.cursor.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_ENABLED=false

# Trading safety defaults.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
QUOTE_CURRENCY=KRW
TOTAL_BUDGET_KRW=50000
MAX_POSITION_KRW=10000
MIN_POSITION_KRW=5000
MAX_OPEN_POSITIONS=1
DAILY_LOSS_LIMIT_KRW=1500
STOP_AFTER_CONSECUTIVE_LOSSES=3
TAKE_PROFIT_PCT=1.2
STOP_LOSS_PCT=0.7
TRAILING_STOP_PCT=0.5
TAKER_FEE_PCT=0.05
SLIPPAGE_PCT=0.08
MIN_EXPECTED_NET_PROFIT_PCT=0.5

# Scanner settings.
SCAN_TOP_MARKETS=30
MIN_24H_TRADE_PRICE_KRW=1000000000
BTC_CRASH_5M_PCT=-1.2
